cff-version: 1.2.0
message: "If you use CorteXforge or its datasets in your research, please cite the associated paper."

title: "CorteXforge"
type: software

authors:
  - family-names: "Joly"
    given-names: "Andréa"
    affiliation: "Inria, INSA Lyon, CITI"

version: "1.0.0"

repository-code: "https://github.com/Andreaj42/CorteXforge"

abstract: >
  CorteXforge is an end-to-end framework for planning, executing, and accessing reproducible radio dataset experiments on the SLICES-RI/CorteXlab testbed.

keywords:
  - radio datasets
  - software-defined radio
  - automatic modulation classification
  - reproducible experiments
  - CorteXlab
  - SigMF

license: "BSD-3-Clause"

preferred-citation:
  type: generic
  title: "CorteXforge: Scenario-Based RF Dataset Generation on Real Testbeds"
  authors:
